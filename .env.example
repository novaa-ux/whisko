PORT=4000
HOST=127.0.0.1
# Generate a different random secret for every installation: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

ADMIN_EMAIL=owner@example.com
# Use a unique password with at least 12 characters. Change it before deployment.
ADMIN_PASSWORD=replace-this-before-starting
DATABASE_PATH=./data/whisko.sqlite
# Set these two values when using Turso instead of the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Must be the public website origin in production. In local Vite development:
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0
